# ========================================
# AlphaReport (Claude Code Edition)
# ========================================
# Copy this file to .env:
#   cp .env.example .env

# ============ Feishu Bot ============
# Get these from Feishu Open Platform → App Settings
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxx
FEISHU_ALLOWED_OPEN_IDS=your-open-id

# WebSocket is the default. HTTP fallback requires both separate secrets.
FEISHU_HTTP_CALLBACK_ENABLED=false
FEISHU_INBOX_TOKEN=

# ============ Model API ============
# Python analysis calls the configured model API directly.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
CLAUDE_BOT_MODEL=deepseek-v4-pro
# Normal bot chat maps DEEPSEEK_* into its Claude Code subprocess environment.
# Daily/weekly briefing commands use Claude Code's own environment/settings in
# .claude-bot; configure that runtime separately if model-generated briefs are wanted.

# ============ Optional: Feishu daily/weekly delivery ============
# Set real destination IDs before running delivery commands or scheduling jobs.
# Both ID lists accept comma-separated values. Set each type explicitly.
FEISHU_DAILY_PUSH_IDS=
FEISHU_DAILY_PUSH_TYPE=chat_id
FEISHU_WEEKLY_PUSH_IDS=
FEISHU_WEEKLY_PUSH_TYPE=chat_id
# Use an address reachable from recipients' devices for report links.
ALPHAREPORT_BASE_URL=http://localhost:8000
